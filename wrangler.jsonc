{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c37c6df2-1a8b-4f53-9821-cb23da94eb9a","database_name": "app22" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d331c7274e704c30bbb64f527ece2239" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
